# Port the API listens on. Keep it off 3000 -- that is the Next.js dev server.
PORT=8080

# PostgreSQL connection string.
#   Local docker:  postgresql://forgeuser:forgepassword@localhost:5432/forgeflow?sslmode=disable
#   Neon/hosted:   postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://forgeuser:forgepassword@localhost:5432/forgeflow?sslmode=disable

# Where the frontend runs. Added to the CORS allowlist alongside localhost:3000.
CLIENT_URL=http://localhost:3000

# Clerk backend key (sk_test_... / sk_live_...), from the Clerk dashboard.
# Required: every authenticated route rejects requests without it.
CLERK_SECRET_KEY=

# Google AI Studio key. Only needed if a workflow uses an AI node.
GEMINI_API_KEY=

# Engine tuning (optional).
ENGINE_WORKERS=3
ENGINE_QUEUE_SIZE=100
